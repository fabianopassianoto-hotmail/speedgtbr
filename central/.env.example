# URL pública completa, incluindo /central.
PUBLIC_BASE_URL=https://SEU_DOMINIO/central

# Somente para desenvolvimento local. Use um e-mail já autorizado na tabela usuarios_acessos.
DEV_AUTH_EMAIL=seu-email@exemplo.com
DEV_AUTH_NAME=Seu nome

# E-mail transacional do cadastro (Resend). Configurar no ambiente do Worker/Pages.
# A chave é secreta; não preencher nem versionar credenciais neste arquivo.
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=
