# URL pública completa, incluindo /central. Não há configuração de login.
PUBLIC_BASE_URL=https://SEU_DOMINIO/central


# E-mail transacional do cadastro (Resend). Configurar no ambiente do Worker/Pages.
# A chave é secreta; não preencher nem versionar credenciais neste arquivo.
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=Speed GT Brasil <administracao@speedgtbrasil.com.br>

# Respostas dos pilotos serão encaminhadas para a caixa Gmail existente.
REGISTRATION_EMAIL_REPLY_TO=speedgtbr@gmail.com
